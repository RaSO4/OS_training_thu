+        ".option push",
+        ".option arch, +v",
+        "csrr t0, vlenb",
+        "vsetvli t1, zero, e32, m1, ta, ma",
+        "vse32.v v0, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v1, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v2, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v3, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v4, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v5, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v6, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v7, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v8, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v9, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v10, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v11, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v12, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v13, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v14, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v15, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v16, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v17, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v18, (a0)",
+        "add a0, a0, t0",
