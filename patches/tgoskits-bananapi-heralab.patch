+        "add a0, a0, t0",
+        "vse32.v v27, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v28, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v29, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v30, (a0)",
+        "add a0, a0, t0",
+        "vse32.v v31, (a0)",
+        ".option pop",
+        "ret",
+    )
+}
+
