diff --git a/components/axcpu/src/riscv/vector.rs b/components/axcpu/src/riscv/vector.rs
new file mode 100644
index 0000000..b078d5b
--- /dev/null
+++ b/components/axcpu/src/riscv/vector.rs
@@ -0,0 +1,467 @@
+//! Per-task RISC-V vector state.
+//!
+//! RVV registers are not part of the general-purpose register file.  A task
+//! that uses vector instructions must have `v0-v31` and `vcsr` saved when it is
+//! preempted and restored when it runs again.  The state image is sized for the
+//! widest hart on the supported board (A100, VLEN 1024) and is zeroed before
+//! every save so a narrower X100 image never restores stale upper bytes.
+//!
+//! Cross-VLEN migration is not supported: restoring an image saved on a hart
+//! with a different `vlenb` clears the vector registers instead of loading a
+//! meaningless mixed-width image.
+
+use core::arch::{asm, naked_asm};
+
+use riscv::register::sstatus::{self, VS};
+
+/// Bytes per vector register on the widest supported hart (VLEN 1024 bits).
+const MAX_VLEN_BYTES: usize = 128;
+
+/// Raw image for `v0-v31`: 32 registers times the maximum VLEN.
+const VECTOR_IMAGE_BYTES: usize = 32 * MAX_VLEN_BYTES;
+
+/// Saved vector state of one task.
+///
+/// `vs` follows the architectural `sstatus.VS` state machine: `Off` means the
+/// task has no vector state, `Initial` means the registers are architecturally
+/// zero, `Clean` means `regs` is the authoritative copy, and `Dirty` means the
+/// hardware copy is newer than `regs`.  A task context never enters a switch
+/// while its own `vs` is `Dirty`; the current hart's `sstatus.VS` is checked
+/// instead.
+#[repr(C, align(128))]
+pub struct VectorState {
+    regs: [u8; VECTOR_IMAGE_BYTES],
+    /// Bytes per register at the last save (0 when the task never used RVV).
+    vlenb: usize,
+    vcsr: usize,
+    /// Vector type and length CSRs.  These are read-only and must be restored
+    /// through `vsetvl`, not by writing the CSRs directly.
+    vtype: usize,
+    vl: usize,
+    /// Vector start index; user code normally leaves it zero, but an
+    /// interrupted vector instruction may have a non-zero value.
+    vstart: usize,
+    vs: VS,
+}
+
+impl Default for VectorState {
+    fn default() -> Self {
+        Self {
+            regs: [0; VECTOR_IMAGE_BYTES],
+            vlenb: 0,
+            vcsr: 0,
+            vtype: 0,
+            vl: 0,
+            vstart: 0,
+            vs: VS::Initial,
+        }
+    }
+}
+
+impl core::fmt::Debug for VectorState {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("VectorState")
+            .field("vlenb", &self.vlenb)
+            .field("vtype", &self.vtype)
+            .field("vl", &self.vl)
+            .field("vs", &self.vs)
+            .finish_non_exhaustive()
+    }
+}
+
+impl VectorState {
+    /// Saves the current hart's vector registers into this task image.
+    fn save(&mut self) {
+        // Read the user's vector shape before the save helper changes
+        // `vtype`/`vl` (its `vsetvli` selects the temporary e32,m8 layout).
+        self.vlenb = read_vlenb();
+        self.vcsr = read_vcsr();
+        self.vtype = read_vtype();
+        self.vl = read_vl();
+        self.vstart = read_vstart();
+
+        // Zero the full image first: a narrower VLEN writes only a prefix, and
+        // the untouched suffix must not leak a previous task's bytes.
+        self.regs.fill(0);
+        unsafe {
+            // SAFETY: the scheduler calls this with IRQs disabled on the same
+            // hart that owns the live vector registers, and `sstatus.VS` is
+            // Dirty, so every vector instruction below is legal.
+            save_vector_registers(self.regs.as_mut_ptr());
+        }
+    }
+
+    /// Restores this task image onto the current hart.
+    fn restore(&self) {
+        let current_vlenb = read_vlenb();
+        if self.vlenb != 0 && self.vlenb != current_vlenb {
+            // A live vector image cannot be reinterpreted across VLEN widths;
+            // clearing is safer than loading a mixed-width image.
+            unsafe {
+                // SAFETY: caller has set `sstatus.VS = Dirty`.
+                clear_vector_registers();
+            }
+            write_vcsr(0);
+            return;
+        }
+        unsafe {
+            // SAFETY: caller has set `sstatus.VS = Dirty`; the image is fully
+            // initialized for the current VLEN (or zero for an Initial task).
+            restore_vector_registers(self.regs.as_ptr());
+        }
+        write_vcsr(self.vcsr);
+        write_vtype_vl(self.vtype, self.vl);
+        write_vstart(self.vstart);
+    }
+
+    /// Handles vector state context switching.
+    ///
+    /// Mirrors [`FpState::switch_to`](super::context::FpState): save the
+    /// current task when the hart reports `Dirty`, restore or clear the next
+    /// task, then publish the next task's `VS` value.
+    pub fn switch_to(&mut self, next: &VectorState) {
+        let current_vs = sstatus::read().vs();
+        if current_vs == VS::Dirty {
+            self.save();
+            self.vs = VS::Clean;
+        }
+
+        // Vector instructions need a non-Off VS.  Initial tasks are cleared
+        // explicitly; Clean tasks load their saved image.
+        if matches!(next.vs, VS::Clean | VS::Initial) {
+            unsafe {
+                // SAFETY: the scheduler owns the hart with IRQs disabled; only
+                // the local sstatus changes.
+                sstatus::set_vs(VS::Dirty);
+            }
+        }
+        match next.vs {
+            VS::Clean => next.restore(),
+            VS::Initial => unsafe {
+                // SAFETY: VS was set to Dirty above.
+                clear_vector_registers();
+            },
+            VS::Off => {}
+            VS::Dirty => unreachable!("next task's vector state must not be dirty"),
+        }
+        unsafe {
+            // SAFETY: every VS variant is a valid architectural encoding and
+            // the handoff still owns this hart.
+            sstatus::set_vs(next.vs);
+        }
+    }
+}
+
+#[inline]
+fn read_vlenb() -> usize {
+    let value: usize;
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "csrr {value}, vlenb",
+            ".option pop",
+            value = out(reg) value,
+        );
+    }
+    value
+}
+
+#[inline]
+fn read_vcsr() -> usize {
+    let value: usize;
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "csrr {value}, vcsr",
+            ".option pop",
+            value = out(reg) value,
+        );
+    }
+    value
+}
+
+#[inline]
+fn write_vcsr(value: usize) {
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "csrw vcsr, {value}",
+            ".option pop",
+            value = in(reg) value,
+        );
+    }
+}
+
+#[inline]
+fn read_vtype() -> usize {
+    let value: usize;
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "csrr {value}, vtype",
+            ".option pop",
+            value = out(reg) value,
+        );
+    }
+    value
+}
+
+#[inline]
+fn read_vl() -> usize {
+    let value: usize;
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "csrr {value}, vl",
+            ".option pop",
+            value = out(reg) value,
+        );
+    }
+    value
+}
+
+#[inline]
+fn read_vstart() -> usize {
+    let value: usize;
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "csrr {value}, vstart",
+            ".option pop",
+            value = out(reg) value,
+        );
+    }
+    value
+}
+
+#[inline]
+fn write_vstart(value: usize) {
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "csrw vstart, {value}",
+            ".option pop",
+            value = in(reg) value,
+        );
+    }
+}
+
+/// Restores `vtype` and `vl` through `vsetvl`; both CSRs are read-only.
+#[inline]
+fn write_vtype_vl(vtype: usize, vl: usize) {
+    unsafe {
+        asm!(
+            ".option push",
+            ".option arch, +v",
+            "vsetvl zero, {vl}, {vtype}",
+            ".option pop",
+            vl = in(reg) vl,
+            vtype = in(reg) vtype,
+        );
+    }
+}
+
+/// Stores `v0-v31` as four m8 groups, `8*vlenb` bytes per group.
+#[unsafe(naked)]
+unsafe extern "C" fn save_vector_registers(_state: *mut u8) {
